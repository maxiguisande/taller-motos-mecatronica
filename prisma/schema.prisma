// Esquema de datos del Taller de Motos
// Motor: PostgreSQL (Neon en la nube).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Autenticación / personal del taller
// ─────────────────────────────────────────────
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  nombre       String
  passwordHash String
  rol          String         @default("empleado") // "admin" | "empleado"
  activo       Boolean        @default(true)
  ordenes      OrdenTrabajo[] @relation("Mecanico")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// Clientes, contactos y motos
// ─────────────────────────────────────────────
model Cliente {
  id        String         @id @default(cuid())
  nombre    String
  apellido  String
  direccion String?
  notas     String?
  contactos    Contacto[]
  motos        Moto[]
  ordenes      OrdenTrabajo[]
  turnos       Turno[]
  presupuestos Presupuesto[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([apellido, nombre])
}

model Contacto {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  tipo      String // "celular" | "fijo" | "whatsapp" | "email" | "instagram"
  valor     String
  etiqueta  String? // "personal", "trabajo", etc.
  principal Boolean @default(false)

  @@index([clienteId])
}

model Moto {
  id           String         @id @default(cuid())
  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String
  marca        String
  modelo       String
  anio         Int?
  patente      String?
  cilindrada   Int? // cc
  color        String?
  numeroChasis String?
  numeroMotor  String?
  fotoUrl      String?
  // Mantenimiento / próximo service
  kmActual            Int?
  proximoServiceKm    Int?
  proximoServiceFecha DateTime?
  notas        String?
  ordenes      OrdenTrabajo[]
  turnos       Turno[]
  presupuestos Presupuesto[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([patente])
  @@index([clienteId])
}

// ─────────────────────────────────────────────
// Catálogo: servicios (mano de obra) y grupos
// ─────────────────────────────────────────────
model Servicio {
  id          String          @id @default(cuid())
  nombre      String
  descripcion String?
  duracionMin Int?
  activo      Boolean         @default(true)
  grupos      GrupoServicio[] @relation("GrupoServicios")
  items       OrdenItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([nombre])
}

model GrupoServicio {
  id          String     @id @default(cuid())
  nombre      String
  descripcion String?
  color       String     @default("#57a12e")
  servicios   Servicio[] @relation("GrupoServicios")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([nombre])
}

// ─────────────────────────────────────────────
// Repuestos / insumos con control de stock
// ─────────────────────────────────────────────
model Producto {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Decimal     @default(0) @db.Decimal(12, 2) // precio de venta
  costo       Decimal?    @db.Decimal(12, 2) // costo de compra
  stock       Int         @default(0)
  stockMinimo Int         @default(0)
  activo      Boolean     @default(true)
  items       OrdenItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([nombre])
}

// ─────────────────────────────────────────────
// Órdenes de trabajo
// ─────────────────────────────────────────────
model OrdenTrabajo {
  id          String      @id @default(cuid())
  numero      Int         @unique @default(autoincrement()) // número correlativo (#0001)
  cliente     Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId   String
  moto        Moto?       @relation(fields: [motoId], references: [id], onDelete: SetNull)
  motoId      String?
  mecanico    User?       @relation("Mecanico", fields: [mecanicoId], references: [id], onDelete: SetNull)
  mecanicoId  String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)
  presupuestoId String?
  turno       Turno?      @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  turnoId     String?
  fecha       DateTime    @default(now())
  estado      String      @default("pendiente") // presupuesto|pendiente|en_proceso|completado
  kilometraje Int?
  // Control de tiempo del trabajo
  iniciadoEn   DateTime?
  finalizadoEn DateTime?
  notas       String?
  // Cobros (moneda por línea: cada ítem —incluida la mano de obra— puede ser ARS o USD)
  totalArs   Decimal @default(0) @db.Decimal(12, 2) // total en pesos
  totalUsd   Decimal @default(0) @db.Decimal(12, 2) // total en dólares
  estadoPago String  @default("pendiente") // pendiente|parcial|pagado
  medioPago  String? // efectivo|transferencia|tarjeta|mercadopago
  items      OrdenItem[]
  fotos      Foto[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([fecha])
  @@index([clienteId])
  @@index([motoId])
}

// Ítem de una orden: servicio (mano de obra), repuesto o manual.
model OrdenItem {
  id          String       @id @default(cuid())
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenId     String
  tipo        String       @default("servicio") // servicio|repuesto|manual|mano_obra
  servicio    Servicio?    @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  servicioId  String?
  producto    Producto?    @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoId  String?
  descripcion String
  precio      Decimal      @default(0) @db.Decimal(12, 2)
  moneda      String       @default("ARS") // ARS|USD
  cantidad    Int          @default(1)
  realizado   Boolean      @default(false)
  fotos       Foto[]

  @@index([ordenId])
}

// Fotos de chequeo: de un ítem, o de la orden (ingreso/salida de la moto).
model Foto {
  id          String        @id @default(cuid())
  item        OrdenItem?    @relation(fields: [ordenItemId], references: [id], onDelete: Cascade)
  ordenItemId String?
  orden       OrdenTrabajo? @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenId     String?
  categoria   String        @default("item") // item | ingreso | salida
  url         String
  createdAt   DateTime      @default(now())

  @@index([ordenItemId])
  @@index([ordenId])
}

// ─────────────────────────────────────────────
// Turnos / agenda
// ─────────────────────────────────────────────
model Turno {
  id            String       @id @default(cuid())
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId     String
  moto          Moto?        @relation(fields: [motoId], references: [id], onDelete: SetNull)
  motoId        String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)
  presupuestoId String?
  fecha     DateTime
  motivo    String?
  estado    String   @default("confirmado") // confirmado|cancelado
  notas     String?
  ordenes   OrdenTrabajo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([clienteId])
}

// ─────────────────────────────────────────────
// Presupuestos (cotizaciones para enviar al cliente)
// ─────────────────────────────────────────────
model Presupuesto {
  id           String                 @id @default(cuid())
  numero       Int                    @unique @default(autoincrement())
  cliente      Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String
  moto         Moto?                  @relation(fields: [motoId], references: [id], onDelete: SetNull)
  motoId       String?
  titulo       String?
  estado       String                 @default("borrador") // borrador|enviado|aprobado|rechazado|vencido
  validezHasta DateTime?
  clienteTrae  String? // cosas que aporta el cliente (una por línea)
  notaFinal    String?
  servicios    PresupuestoServicio[]
  items        PresupuestoItem[]
  turnos       Turno[]
  ordenes      OrdenTrabajo[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([clienteId])
}

// Servicios/tareas incluidas en el presupuesto (checklist, sin precio).
model PresupuestoServicio {
  id            String      @id @default(cuid())
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  presupuestoId String
  descripcion   String

  @@index([presupuestoId])
}

// Líneas de costo del presupuesto, cada una con su moneda.
model PresupuestoItem {
  id            String      @id @default(cuid())
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  presupuestoId String
  descripcion   String
  importe       Decimal     @default(0) @db.Decimal(12, 2)
  moneda        String      @default("ARS") // ARS|USD

  @@index([presupuestoId])
}
