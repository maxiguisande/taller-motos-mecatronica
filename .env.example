# Copiá este archivo como .env y completá los valores.

# PostgreSQL (Neon en la nube o local). Ver README.
DATABASE_URL="postgresql://usuario:password@host:5432/taller?sslmode=require"

# Secreto de Auth.js. Generalo con: npx auth secret
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Necesario en producción detrás de proxy (Vercel):
# AUTH_TRUST_HOST=true
